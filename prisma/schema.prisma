generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      UserRole  @default(CUSTOMER)
  createdAt DateTime  @default(now())
  author    AuthorProfile?
  orders    Order[]
}

model AuthorProfile {
  id              String @id @default(cuid())
  user            User   @relation(fields: [userId], references: [id])
  userId          String @unique
  bio             String?
  payoutAccountId String?
  books           Book[]
  createdAt       DateTime @default(now())
}

model Book {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  priceCents  Int
  isbn        String?
  coverKey    String?
  files       File[]
  author      AuthorProfile @relation(fields: [authorId], references: [id])
  authorId    String
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  status      BookStatus @default(DRAFT)
}

model File {
  id        String @id @default(cuid())
  book      Book   @relation(fields: [bookId], references: [id])
  bookId    String
  s3Key     String
  format    String
  sizeBytes Int
}

model Order {
  id              String     @id @default(cuid())
  user            User       @relation(fields: [userId], references: [id])
  userId          String
  totalCents      Int
  stripePaymentId String?
  items           OrderItem[]
  createdAt       DateTime   @default(now())
}

model OrderItem {
  id         String @id @default(cuid())
  order      Order  @relation(fields: [orderId], references: [id])
  orderId    String
  bookId     String
  priceCents Int
  qty        Int
}

enum UserRole {
  CUSTOMER
  AUTHOR
  ADMIN
}

enum BookStatus {
  DRAFT
  PUBLISHED
  REMOVED
}
